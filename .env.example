# DEMOKRATIC — Environment Variables
# Copy this file to .env and fill in your actual keys

# Google Gemini AI API Key (required)
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase API Key (optional - for leaderboard feature)
FIREBASE_API_KEY=your_firebase_api_key_here

# Server port (default: 8080)
PORT=8080

# Environment (development or production)
NODE_ENV=development

# Allowed origin for CORS in production
# ALLOWED_ORIGIN=https://your-deployed-app.run.app
